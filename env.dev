# The configuration of the TZgram build that is shared with everyone.
#
# The local .env file has the same keys - it is in the .gitignore and holds
# the signing password, which never goes into the repository. This file is
# the base of it: copy it to .env and fill in the password.
#
#   copy env.dev .env
#
api_id=
api_hash=
version=
sign_pfx=path
sign_password=
sign_cert=path
sign_timestamp=http://timestamp.digicert.com
signtool=path
iscc=
